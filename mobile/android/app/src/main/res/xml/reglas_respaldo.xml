<?xml version="1.0" encoding="utf-8"?>
<!-- Nada de Caporal sale del celular por los respaldos de Android (nube de Google ni traspaso a otro
     equipo): la base va cifrada con una llave que no se respalda, y las fotos de comprobantes son
     datos de terceros (Ley 1581). La copia de seguridad la hace Caporal en su propio servidor. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
