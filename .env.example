# Copie este archivo como .env y cambie los valores. Nunca suba .env al repositorio.
POSTGRES_DB=caporal
POSTGRES_USER=caporal
POSTGRES_PASSWORD=cambie-esta-clave
# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambie-este-secreto-de-al-menos-32-caracteres


# Solo en el VPS (deploy/vps/.env)
# Llave PÚBLICA de age para cifrar respaldos (la privada nunca va al servidor)
RESPALDO_CLAVE_PUBLICA=
# Nombre público de la API (para la vigilancia)
DOMINIO_PUBLICO=
# Opcional: URL que recibe alertas (ntfy.sh, Slack, Discord)
ALERTA_WEBHOOK=
